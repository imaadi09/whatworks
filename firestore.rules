rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get current user's phone number
    function getCurrentUserPhone() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone;
    }
    
    // USERS COLLECTION
    match /users/{userId} {
      // planType / planExpiry are the paywall, and orgId is the seat: all three
      // are written only by the Admin SDK (payment webhook, joinOrganization).
      // The client writes its own profile with UserModel.toMap(), which carries
      // those keys, so a create checks their VALUES rather than banning the keys
      // outright — otherwise first-time sign-in would be denied.
      function newProfileClaimsNothing() {
        return (!request.resource.data.keys().hasAny(['planType'])
                || request.resource.data.planType == 'basic'
                || request.resource.data.planType == 'free')
            && (!request.resource.data.keys().hasAny(['planExpiry'])
                || request.resource.data.planExpiry == null)
            && (!request.resource.data.keys().hasAny(['orgId'])
                || request.resource.data.orgId == null);
      }
      
      allow read: if isAuthenticated();
      allow list: if isAuthenticated();
      
      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && newProfileClaimsNothing();
      
      // affectedKeys() lists only fields whose value CHANGED, so re-sending an
      // unchanged planType (as a whole-document update does) still passes.
      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['planType', 'planExpiry', 'orgId']);
      
      // Account deletion (AuthRepository.deleteAccount) removes the caller's
      // own doc; nobody may delete anyone else's.
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // TASKS COLLECTION
    match /tasks/{taskId} {
      function isTaskParticipant() {
        return resource != null && (
          resource.data.createdBy == request.auth.uid
          || resource.data.assignedToUid == request.auth.uid
          || (resource.data.assignedToPhone != null && resource.data.assignedToPhone == getCurrentUserPhone())
          // NOTE: must stay `in` (not `is list && hasAny`) — only the `in` form is
          // statically provable for array-contains list queries; the guarded form
          // gets the whole participants sync query PERMISSION_DENIED.
          || request.auth.uid in resource.data.participants
          || (resource.data.extraFields is map
              && resource.data.extraFields.assigneeUids is list
              && resource.data.extraFields.assigneeUids.hasAny([request.auth.uid]))
        );
      }
      
      allow read: if isAuthenticated() && isTaskParticipant();
      
      allow create: if isAuthenticated()
                    && request.resource.data.createdBy == request.auth.uid;
      
      allow update: if isAuthenticated() 
                    && (resource.data.createdBy == request.auth.uid
                        || resource.data.assignedToUid == request.auth.uid
                        || (resource.data.assignedToPhone != null && resource.data.assignedToPhone == getCurrentUserPhone())
                        || (resource.data.participants is list && resource.data.participants.hasAny([request.auth.uid]))
                        || (resource.data.extraFields is map
                            && resource.data.extraFields.assigneeUids is list
                            && resource.data.extraFields.assigneeUids.hasAny([request.auth.uid])));
      
      allow delete: if isAuthenticated() 
                    && (resource.data.createdBy == request.auth.uid
                        // Purge from the Deleted view: any participant may
                        // hard-delete a task that is already soft-deleted,
                        // else an assignee-side purge would be rejected here
                        // and the card resurrected on the next full sync.
                        || (isTaskParticipant() && resource.data.isDeleted == true));
      
      allow list: if isAuthenticated()
                  && request.query.resourceKeys.size() <= 100;
      
      // MESSAGES SUBCOLLECTION
      match /messages/{messageId} {
        function isTaskParticipantForMessage() {
          let task = get(/databases/$(database)/documents/tasks/$(taskId));
          return task.data.createdBy == request.auth.uid
                 || task.data.assignedToUid == request.auth.uid
                 || (task.data.assignedToPhone != null && task.data.assignedToPhone == getCurrentUserPhone())
                 || (task.data.participants is list && task.data.participants.hasAny([request.auth.uid]))
                 || (task.data.extraFields is map
                     && task.data.extraFields.assigneeUids is list
                     && task.data.extraFields.assigneeUids.hasAny([request.auth.uid]));
        }
        
        allow read: if isAuthenticated() && isTaskParticipantForMessage();
        
        allow create: if isAuthenticated()
                      && isTaskParticipantForMessage()
                      && (request.resource.data.senderId == request.auth.uid
                          || request.resource.data.senderId == 'system');
        
        // Allow sender to edit/soft-delete, OR any participant to update
        // receipt maps (downloadedBy / readBy / deliveredTo)
        allow update: if isAuthenticated() && isTaskParticipantForMessage() && (
          // Sender editing their own message (edit text, soft-delete)
          (resource.data.senderId == request.auth.uid
           && request.resource.data.senderId == resource.data.senderId
           && request.resource.data.taskId == resource.data.taskId
           && request.resource.data.createdAt == resource.data.createdAt)
          ||
          // Any participant can mark downloaded / delivered / read
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['downloadedBy', 'readBy', 'deliveredTo']))
          ||
          // Any participant may answer / close an action card on a message they
          // did NOT author — the requested person must be able to Reply or mark
          // Done on a Request (and mark Done on Visit/Call/Meeting). These
          // action-response fields are the ONLY ones a non-sender may write.
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'isReplied', 'queryReply', 'repliedBy', 'repliedAt',
                'isFollowUpDone', 'followUpDoneBy', 'followUpDoneAt'
              ]))
        );
        
        allow delete: if isAuthenticated()
                      && resource.data.senderId == request.auth.uid;
      }
      
      // SYSTEM LOGS SUBCOLLECTION
      match /system_logs/{logId} {
        // MUST resolve membership from the PARENT task via get(). The old form
        // called isTaskParticipant() here, but inside this match `resource` is
        // the LOG document, which carries only taskId/action/performedBy/
        // details/createdAt - no createdBy/assignedToUid/participants - and is
        // null on create. So the check could never be true and every write was
        // denied: the collection group is empty project-wide as a result. Same
        // get()-based shape as the messages subcollection and as the
        // sales_enquiries / crm_records log rules.
        function isTaskParticipantForLog() {
          let task = get(/databases/$(database)/documents/tasks/$(taskId));
          return task.data.createdBy == request.auth.uid
                 || task.data.assignedToUid == request.auth.uid
                 || (task.data.assignedToPhone != null && task.data.assignedToPhone == getCurrentUserPhone())
                 || (task.data.participants is list
                     && task.data.participants.hasAny([request.auth.uid]))
                 || (task.data.extraFields is map
                     && task.data.extraFields.assigneeUids is list
                     && task.data.extraFields.assigneeUids.hasAny([request.auth.uid]));
        }

        allow read: if isAuthenticated() && isTaskParticipantForLog();
        // Write-once, append-only. The app writes with set(merge: true), which is
        // a create OR an update, so update is permitted only while the payload is
        // byte-identical to what is stored - an idempotent re-write, never an
        // edit of the log history.
        allow create: if isAuthenticated() && isTaskParticipantForLog();
        allow update: if isAuthenticated() && isTaskParticipantForLog()
                      && request.resource.data.diff(resource.data).affectedKeys().size() == 0;
        // A sender may undo a just-sent action card (delete-for-everyone within
        // the short window). The mirror row is keyed by the message id and
        // records who performed the action, so only that author may remove it —
        // the append-only guarantee for everyone else's history is unchanged.
        allow delete: if isAuthenticated() && isTaskParticipantForLog()
                      && resource.data.performedBy == request.auth.uid;
      }
    }
    
    // SALES ENQUIRIES COLLECTION (top-level, NOT nested inside tasks)
    match /sales_enquiries/{enquiryId} {
      function isEnquiryParticipant() {
        return resource != null && (
          resource.data.createdBy == request.auth.uid
          || resource.data.assignedToUid == request.auth.uid
          || (resource.data.assignedToPhone != null && resource.data.assignedToPhone == getCurrentUserPhone())
          // `in` form required for array-contains list-query provability (see tasks).
          || request.auth.uid in resource.data.participants
          || (resource.data.extraFields is map
              && resource.data.extraFields.assigneeUids is list
              && resource.data.extraFields.assigneeUids.hasAny([request.auth.uid]))
        );
      }
      
      allow read: if isAuthenticated() && isEnquiryParticipant();
      
      allow create: if isAuthenticated()
                    && request.resource.data.createdBy == request.auth.uid;
      
      allow update: if isAuthenticated() && isEnquiryParticipant();
      
      allow delete: if isAuthenticated()
                    && resource.data.createdBy == request.auth.uid;
      
      // List: only allow with a query limit (prevents full collection scan)
      allow list: if isAuthenticated()
                  && request.query.resourceKeys.size() <= 100;
      
      // MESSAGES SUBCOLLECTION (within sales enquiries)
      match /messages/{messageId} {
        function isEnquiryParticipantForMessage() {
          let enquiry = get(/databases/$(database)/documents/sales_enquiries/$(enquiryId));
          return enquiry.data.createdBy == request.auth.uid
                 || enquiry.data.assignedToUid == request.auth.uid
                 || (enquiry.data.assignedToPhone != null && enquiry.data.assignedToPhone == getCurrentUserPhone())
                 || (enquiry.data.participants is list
                     && enquiry.data.participants.hasAny([request.auth.uid]))
                 || (enquiry.data.extraFields is map
                     && enquiry.data.extraFields.assigneeUids is list
                     && enquiry.data.extraFields.assigneeUids.hasAny([request.auth.uid]));
        }
        
        allow read: if isAuthenticated() && isEnquiryParticipantForMessage();
        
        allow create: if isAuthenticated()
                      && isEnquiryParticipantForMessage()
                      && (request.resource.data.senderId == request.auth.uid
                          || request.resource.data.senderId == 'system');
        
        // Allow sender to edit, OR any participant to update receipt maps
        allow update: if isAuthenticated() && isEnquiryParticipantForMessage() && (
          (resource.data.senderId == request.auth.uid
           && request.resource.data.senderId == resource.data.senderId)
          ||
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['downloadedBy', 'readBy', 'deliveredTo']))
          ||
          // Any participant may answer / close an action card they did not
          // author (Reply / Done on a Request, Done on Visit/Call/etc).
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'isReplied', 'queryReply', 'repliedBy', 'repliedAt',
                'isFollowUpDone', 'followUpDoneBy', 'followUpDoneAt'
              ]))
        );
        
        allow delete: if isAuthenticated()
                      && resource.data.senderId == request.auth.uid;
      }

      // SYSTEM LOGS SUBCOLLECTION (durable action log, mirrors tasks)
      match /system_logs/{logId} {
        function isEnquiryParticipantForLog() {
          let enquiry = get(/databases/$(database)/documents/sales_enquiries/$(enquiryId));
          return enquiry.data.createdBy == request.auth.uid
                 || enquiry.data.assignedToUid == request.auth.uid
                 || (enquiry.data.assignedToPhone != null && enquiry.data.assignedToPhone == getCurrentUserPhone())
                 || (enquiry.data.participants is list
                     && enquiry.data.participants.hasAny([request.auth.uid]))
                 || (enquiry.data.extraFields is map
                     && enquiry.data.extraFields.assigneeUids is list
                     && enquiry.data.extraFields.assigneeUids.hasAny([request.auth.uid]));
        }

        allow read: if isAuthenticated() && isEnquiryParticipantForLog();
        // Write-once, append-only: clients create a log row keyed by the
        // message id that produced it. `set(merge: true)` from the app is a
        // create-or-update, so update is allowed only while the payload stays
        // identical to what is already stored (idempotent re-write).
        allow create: if isAuthenticated() && isEnquiryParticipantForLog();
        allow update: if isAuthenticated() && isEnquiryParticipantForLog()
                      && request.resource.data.diff(resource.data).affectedKeys().size() == 0;
        // Undo of a just-sent action card by its author only (see tasks mirror).
        allow delete: if isAuthenticated() && isEnquiryParticipantForLog()
                      && resource.data.performedBy == request.auth.uid;
      }
    }
    
    // Teams (task_teams / sales_teams / crm_teams) are local-only (SQLite)
    // and have no Firestore rules — the catch-all deny below locks them out.
    
    // CRM RECORDS COLLECTION (mirrors sales_enquiries rules)
    match /crm_records/{recordId} {
      function isCrmParticipant() {
        return resource != null && (
          resource.data.createdBy == request.auth.uid
          || resource.data.assignedToUid == request.auth.uid
          || (resource.data.assignedToPhone != null && resource.data.assignedToPhone == getCurrentUserPhone())
          // `in` form required for array-contains list-query provability (see tasks).
          || request.auth.uid in resource.data.participants
          || (resource.data.extraFields is map
              && resource.data.extraFields.assigneeUids is list
              && resource.data.extraFields.assigneeUids.hasAny([request.auth.uid]))
        );
      }
      
      allow read: if isAuthenticated() && isCrmParticipant();
      
      allow create: if isAuthenticated()
                    && request.resource.data.createdBy == request.auth.uid;
      
      allow update: if isAuthenticated() && isCrmParticipant();
      
      allow delete: if isAuthenticated()
                    && resource.data.createdBy == request.auth.uid;
      
      allow list: if isAuthenticated()
                  && request.query.resourceKeys.size() <= 100;
      
      // MESSAGES SUBCOLLECTION (within CRM records)
      match /messages/{messageId} {
        function isCrmParticipantForMessage() {
          let record = get(/databases/$(database)/documents/crm_records/$(recordId));
          return record.data.createdBy == request.auth.uid
                 || record.data.assignedToUid == request.auth.uid
                 || (record.data.assignedToPhone != null && record.data.assignedToPhone == getCurrentUserPhone())
                 || (record.data.participants is list
                     && record.data.participants.hasAny([request.auth.uid]))
                 || (record.data.extraFields is map
                     && record.data.extraFields.assigneeUids is list
                     && record.data.extraFields.assigneeUids.hasAny([request.auth.uid]));
        }
        
        allow read: if isAuthenticated() && isCrmParticipantForMessage();
        
        allow create: if isAuthenticated()
                      && isCrmParticipantForMessage()
                      && (request.resource.data.senderId == request.auth.uid
                          || request.resource.data.senderId == 'system');
        
        allow update: if isAuthenticated() && isCrmParticipantForMessage() && (
          (resource.data.senderId == request.auth.uid
           && request.resource.data.senderId == resource.data.senderId)
          ||
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['downloadedBy', 'readBy', 'deliveredTo']))
          ||
          // Any participant may answer / close an action card they did not
          // author (Reply / Done on a Request, Done on Visit/Call/etc).
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'isReplied', 'queryReply', 'repliedBy', 'repliedAt',
                'isFollowUpDone', 'followUpDoneBy', 'followUpDoneAt'
              ]))
        );
        
        allow delete: if isAuthenticated()
                      && resource.data.senderId == request.auth.uid;
      }

      // SYSTEM LOGS SUBCOLLECTION (durable action log, mirrors tasks)
      match /system_logs/{logId} {
        function isCrmParticipantForLog() {
          let record = get(/databases/$(database)/documents/crm_records/$(recordId));
          return record.data.createdBy == request.auth.uid
                 || record.data.assignedToUid == request.auth.uid
                 || (record.data.assignedToPhone != null && record.data.assignedToPhone == getCurrentUserPhone())
                 || (record.data.participants is list
                     && record.data.participants.hasAny([request.auth.uid]))
                 || (record.data.extraFields is map
                     && record.data.extraFields.assigneeUids is list
                     && record.data.extraFields.assigneeUids.hasAny([request.auth.uid]));
        }

        allow read: if isAuthenticated() && isCrmParticipantForLog();
        allow create: if isAuthenticated() && isCrmParticipantForLog();
        allow update: if isAuthenticated() && isCrmParticipantForLog()
                      && request.resource.data.diff(resource.data).affectedKeys().size() == 0;
        // Undo of a just-sent action card by its author only (see tasks mirror).
        allow delete: if isAuthenticated() && isCrmParticipantForLog()
                      && resource.data.performedBy == request.auth.uid;
      }
    }
    
    // APP COUNTERS COLLECTION (sequential ID generation)
    match /app_counters/{counterType} {
      allow read, write: if isAuthenticated();
    }
    
    // ORGANIZATIONS COLLECTION
    // Subscription/billing fields are website-owned (written via Admin SDK, which
    // bypasses these rules). Clients get read-only access + limited admin edits.
    match /organizations/{orgId} {
      // Admin check against the stored org doc (used where `resource` is a subdoc).
      function isOrgAdminByGet() {
        let org = get(/databases/$(database)/documents/organizations/$(orgId)).data;
        return isAuthenticated() && (
          org.ownerUid == request.auth.uid
          || (org.adminUids is list && org.adminUids.hasAny([request.auth.uid]))
        );
      }
      // Member check: an admin, or holds a seat in the members subcollection.
      function isOrgMemberByGet() {
        return isOrgAdminByGet()
          || (isAuthenticated()
              && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)));
      }
      
      // Read the org doc if the caller is an admin or holds a seat.
      allow get: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid
        || (resource.data.adminUids is list && resource.data.adminUids.hasAny([request.auth.uid]))
        || exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
      );
      
      // Clients never query orgs directly (join happens via Cloud Function).
      allow list: if false;
      
      // Org lifecycle is website-owned (Admin SDK).
      allow create, delete: if false;
      
      // Admins may only edit app-owned fields (name/adminUids); all
      // website-owned billing fields are rejected by the hasOnly() guard.
      allow update: if isAuthenticated()
                    && (resource.data.ownerUid == request.auth.uid
                        || (resource.data.adminUids is list
                            && resource.data.adminUids.hasAny([request.auth.uid])))
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['name', 'adminUids', 'updatedAt']);
      
      // PAYMENTS SUBCOLLECTION (website-owned, admin read-only)
      match /payments/{paymentId} {
        allow read: if isOrgAdminByGet();
        allow write: if false;
      }
      
      // MEMBERS SUBCOLLECTION (seat records; managed by Cloud Functions/Admin SDK)
      match /members/{memberId} {
        allow read: if isOrgMemberByGet();
        allow write: if false;
      }
    }
    
    // PAYMENTS COLLECTION (one doc per Razorpay order, doc id = order id)
    // Written only by the Admin SDK: createRazorpayOrder inserts it as
    // 'pending' and razorpayWebhook transitions it. Clients read their own so
    // account.html can list invoices with the user's OTP session.
    match /payments/{orderId} {
      allow get, list: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    
    // Invoice number counters — Admin SDK only, never readable by clients.
    match /counters/{counterId} {
      allow read, write: if false;
    }
    
    // Deny access to all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
