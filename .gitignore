# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Build artifacts
*.apk
*.aab

# Environment & Secrets (Security)
.env
.env.*
!.env.example
*.env
.env.fcm
# Firebase client config (holds the Android API key - keep local, never publish)
google-services.json
android/google-services.json
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Release signing (back these up privately - never commit)
android/key.properties
android/upload-keystore.jks

# Firebase Admin service-account key (SECRET - never commit)
service-account.json

# Local git history backup bundles
*.bundle

functions/node_modules/
install_deps.js
analyze_out.txt

# Local scratch / build-analyze outputs (never committed)
/_scratch/
/analyze_*.txt
/*_out.txt
/bmp_diff.txt
/marker_test.txt
/commit_msg.txt
